{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MenuTableOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": ${menu_table_resources}
    }
  ]
}
