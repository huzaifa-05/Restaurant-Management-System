{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OrdersTableOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query"
      ],
      "Resource": ${orders_table_resources}
    }
  ]
}
